#--------------------------------------------------------------------
# Example Environment Configuration file (upstream CI4 template)
#
# For local sdp-api-ci-2 + shared db_sdp setup, prefer:
#   cp .env.example .env
# (.env.example has ready-to-use MariaDB / baseURL defaults.)
#
# This file lists most framework settings commented out. Un-comment
# a line (remove '#') to override when using this as a base.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Shared legacy MariaDB (OrbStack container sdp-mariadb — see 102sdp/docs/LOCAL_DEV_DB.md)
# database.default.hostname = 127.0.0.1
# database.default.database = db_sdp
# database.default.username = sdp
# database.default.password = sdp_local
# database.default.DBDriver = MySQLi
# database.default.port = 3307
# database.default.charset = utf8mb4
# database.default.DBCollat = utf8mb4_general_ci
#
# Do NOT run greenfield migrations against db_sdp without a plan.
#
# Topology: single (one shared DB) | multi (one DB/schema per org code)
# database.topology = single
# database.tenants.LP-CIPINANG = lp_cipinang
#
# Tests stay on in-memory SQLite
# database.tests.DBDriver = SQLite3
# database.tests.database = :memory:

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4
