#--------------------------------------------------------------------
# sdp-api-ci-2 — local development example
#
# Setup:
#   1. cp .env.example .env
#   2. Start shared MariaDB (from sibling 102sdp repo, if you use that stack):
#        cd ../102sdp && docker compose -f docker-compose.mariadb.yml up -d
#        ./scripts/restore-db.sh          # first time / after dump change
#      See: 102sdp/docs/LOCAL_DEV_DB.md
#   3. composer install
#   4. php spark serve --host 127.0.0.1 --port 8082
#   5. ./scripts/api.sh login
#
# IMPORTANT
#   - .env is gitignored — never commit real secrets.
#   - Do NOT run full greenfield `php spark migrate` against db_sdp
#     (legacy tables already exist). App-only tables (users/RBAC) may
#     be migrated carefully; ask the team before applying.
#   - Passwords below are local demo values from the OrbStack MariaDB
#     compose stack — change them for anything beyond laptop dev.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Must match how you reach the API (scripts/api.sh default BASE_URL uses 8082)
app.baseURL = 'http://127.0.0.1:8082/'

# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE — shared legacy schema (same DB as CI2 / 102sdp)
#--------------------------------------------------------------------
# OrbStack / Docker: container sdp-mariadb → host 127.0.0.1:3307

database.default.hostname = 127.0.0.1
database.default.database = db_sdp
database.default.username = sdp
database.default.password = sdp_local
database.default.DBDriver = MySQLi
database.default.port = 3307
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.DBDebug = true

# Named group for explicit db_connect('mariadb') — keep in sync with default
database.mariadb.hostname = 127.0.0.1
database.mariadb.database = db_sdp
database.mariadb.username = sdp
database.mariadb.password = sdp_local
database.mariadb.port = 3307
database.mariadb.DBDriver = MySQLi
database.mariadb.charset = utf8mb4
database.mariadb.DBCollat = utf8mb4_general_ci
database.mariadb.DBDebug = true

# Topology: single (one shared DB, org via organizations) | multi (DB per org)
database.topology = single
#
# Multi only — organization code → MariaDB database name
# database.tenants.LP-CIPINANG = lp_cipinang
# database.tenants.RT-SALEMBA  = rt_salemba
# database.tenants.KW-DKI      = kw_dki

# Optional: offline SQLite instead of MariaDB (no legacy tables)
# database.default.DBDriver = SQLite3
# database.default.database = writable/db/sdp_api.sqlite

#--------------------------------------------------------------------
# DATABASE — PHPUnit (keep isolated from db_sdp)
#--------------------------------------------------------------------

database.tests.DBDriver = SQLite3
database.tests.database = :memory:
database.tests.DBPrefix =

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate: php -r "echo 'hex2bin:' . bin2hex(random_bytes(32)), PHP_EOL;"
# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# 4 = runtime errors+ (good for local API work)
logger.threshold = 4

#--------------------------------------------------------------------
# DEMO AUTH (after DemoAuthSeeder + RbacSeeder on app tables)
#--------------------------------------------------------------------
# ./scripts/api.sh login uses:
#   EMAIL=operator@sdp.local  PASSWORD=password
# Set ORG_ID to a unit org id (code 093 / 604, etc.) for UPT-scoped writes:
#   docker exec sdp-mariadb mariadb -usdp -psdp_local db_sdp \
#     -e "SELECT id, code, name FROM organizations"
